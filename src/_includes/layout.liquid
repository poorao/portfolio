<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} | Pooja Rao{% else %}Pooja Rao — HCI & AI Researcher{% endif %}</title>

    <meta name="description" content="{{ description | default: 'Postdoctoral Researcher exploring Human-Computer Interaction, Responsible AI, and Algorithmic Fairness in high-stakes settings.' }}">
    <meta name="author" content="Pooja Rao">
    <meta name="keywords" content="Pooja Rao, Pooja S. B. Rao, HCI, Human-AI Interaction, Responsible AI, Algorithmic Fairness, Interview Training Systems, AI Risk Reporting, UNIL, IIIT Bangalore, FAccT, CHI">

    <!-- Fonts: IBM Plex Sans Variable & Source Code Pro (PostHog Design System) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Source+Code+Pro:wght@400;500;600&display=swap">

    <!-- PostHog Theme Stylesheet -->
    <link href="/css/styles.css" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/assets/pooja-rao.jpg">
    <link rel="apple-touch-icon" href="/assets/pooja-rao.jpg">
</head>

<body>
    <!-- 1. Primary Top Navigation (PostHog 56px Nav Bar) -->
    <header class="primary-nav">
        <div class="primary-nav-inner">
            <a href="/" class="brand-cluster" aria-label="Pooja Rao - Home">
                <div class="brand-mascot">
                    {% include "mascots/hedgehog-logo.svg" %}
                </div>
                <span class="brand-title">Pooja Rao</span>
                <span class="brand-badge">HCI &bull; Responsible AI</span>
            </a>

            <nav aria-label="Main Navigation">
                <ul class="nav-links-cluster">
                    <li><a href="/#about" class="nav-link">About</a></li>
                    <li><a href="/#publications" class="nav-link">Publications</a></li>
                    <li><a href="/#workshops" class="nav-link">Workshops</a></li>
                    <li><a href="/#phd-thesis" class="nav-link">PhD Thesis</a></li>
                    <li><a href="/#activities" class="nav-link">Activities</a></li>
                    <li><a href="/#updates" class="nav-link">Updates</a></li>
                </ul>
            </nav>

            <div class="nav-right-cluster">
                <div class="nav-socials">
                    <a href="https://github.com/poorao" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="GitHub" aria-label="GitHub">
                        <svg viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
                    </a>
                    <a href="https://scholar.google.co.in/citations?user=qt_4EK0AAAAJ&hl=en" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="Google Scholar" aria-label="Google Scholar">
                        <svg viewBox="0 0 24 24"><path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l12 9.5 9-7.125V18h3V9.5L12 0z"/></svg>
                    </a>
                </div>

                <!-- PostHog Universal Saturated CTA Pill -->
                <a href="mailto:poojarao126@gmail.com" class="btn-primary btn-pill" title="Send email to Pooja Rao">
                    Get in touch
                </a>

                <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle navigation menu">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
            </div>
        </div>

        <!-- Mobile Drawer -->
        <div class="mobile-nav-drawer" id="mobileNavDrawer">
            <ul class="mobile-nav-links">
                <li><a href="/#about">About</a></li>
                <li><a href="/#publications">Publications</a></li>
                <li><a href="/#workshops">Workshops</a></li>
                <li><a href="/#phd-thesis">PhD Thesis</a></li>
                <li><a href="/#activities">Activities</a></li>
                <li><a href="/#updates">Updates</a></li>
                <li><a href="/#master-thesis">Master Thesis</a></li>
            </ul>
            <a href="mailto:poojarao126@gmail.com" class="btn-primary" style="width: 100%; text-align: center;">Get in touch &rarr;</a>
        </div>
    </header>

    <!-- 2. Sub-Nav Strip (PostHog 40px Strip) -->
    <div class="sub-nav-strip">
        <div class="sub-nav-inner">
            {% if title %}
            <div class="sub-nav-breadcrumb">
                <a href="/">Home</a>
                <span>/</span>
                <span>Research Detail</span>
                <span>/</span>
                <span style="color: var(--color-ink); font-weight: 600;">{{ title | truncate: 45 }}</span>
            </div>
            <a href="/" class="btn-tertiary" style="padding: 4px 8px; font-size: 13px;">&larr; Back to Portfolio</a>
            {% else %}
            <ul class="sub-nav-anchors">
                <li class="sub-nav-item"><a href="#about">About</a></li>
                <li class="sub-nav-item"><a href="#publications">Publications</a></li>
                <li class="sub-nav-item"><a href="#workshops">Workshops</a></li>
                <li class="sub-nav-item"><a href="#phd-thesis">PhD Thesis</a></li>
                <li class="sub-nav-item"><a href="#activities">Activities</a></li>
                <li class="sub-nav-item"><a href="#updates">Updates</a></li>
                <li class="sub-nav-item"><a href="#master-thesis">Master's</a></li>
            </ul>
            <span class="caption-xs" style="color: var(--color-mute);">Postdoctoral Researcher &bull; IIIT Bangalore</span>
            {% endif %}
        </div>
    </div>

    <!-- 3. Main Content Container -->
    <div class="site-wrapper">
        <div class="container">
            <div class="layout-grid">
                {{ content }}
            </div>
        </div>
    </div>

    <!-- 4. Footer (PostHog 4-Column Directory + Brand Tribute) -->
    <footer class="footer-section">
        <div class="footer-inner">
            <div class="footer-grid">
                <div class="footer-column">
                    <h4 class="footer-column-title">Research</h4>
                    <ul class="footer-links-list">
                        <li><a href="/#publications">Selected Publications</a></li>
                        <li><a href="/#phd-thesis">PhD Dissertation (UNIL)</a></li>
                        <li><a href="/participatory-risks-facct/">Participatory Risks (FAccT '26)</a></li>
                        <li><a href="/risk-catalog/">AI Model Risk Catalog (AIES '25)</a></li>
                        <li><a href="/hiring-bias/">Cultural Bias in Hiring (AIES '25)</a></li>
                    </ul>
                </div>

                <div class="footer-column">
                    <h4 class="footer-column-title">Community &amp; Teaching</h4>
                    <ul class="footer-links-list">
                        <li><a href="/#workshops">Multimodal ML Workshop (AMLD '24)</a></li>
                        <li><a href="/#workshops">Virtual Interviewer Workshop (AMLD '21)</a></li>
                        <li><a href="/#activities">Nokia Bell Labs Invited Seminar</a></li>
                        <li><a href="/#activities">Conference Volunteering</a></li>
                        <li><a href="/#activities">Peer Reviewing</a></li>
                    </ul>
                </div>

                <div class="footer-column">
                    <h4 class="footer-column-title">Connect &amp; Profiles</h4>
                    <ul class="footer-links-list">
                        <li><a href="mailto:poojarao126@gmail.com">Email (poojarao126@gmail.com)</a></li>
                        <li><a href="https://scholar.google.co.in/citations?user=qt_4EK0AAAAJ&hl=en" target="_blank" rel="noopener noreferrer">Google Scholar</a></li>
                        <li><a href="https://orcid.org/0000-0003-3346-2749" target="_blank" rel="noopener noreferrer">ORCID Profile</a></li>
                        <li><a href="https://github.com/poorao" target="_blank" rel="noopener noreferrer">GitHub Profile</a></li>
                        <li><a href="https://www.linkedin.com/in/pooja-rao" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
                    </ul>
                </div>

                <div class="footer-column">
                    <h4 class="footer-column-title">About Pooja Rao</h4>
                    <p style="font-size: 13px; color: var(--color-mute); line-height: 1.5; margin-bottom: 12px;">
                        Postdoctoral Researcher at IIIT Bangalore. Exploring human-AI interaction, responsible AI, and algorithmic auditing.
                    </p>
                    <a href="mailto:poojarao126@gmail.com" class="btn-secondary" style="font-size: 13px; height: 36px; padding: 6px 12px;">
                        Contact via Email
                    </a>
                </div>
            </div>

            <div class="footer-bottom-row">
                <div class="footer-brand-tribute">
                    <div class="footer-mascot">
                        {% include "mascots/hedgehog-waving.svg" %}
                    </div>
                    <span>Pooja Rao &copy; 2026 &bull; Designed in the warm cream &amp; hedgehog sketchbook aesthetic</span>
                </div>
                <a href="#about" class="btn-tertiary" style="font-size: 13px;">Back to top &uarr;</a>
            </div>
        </div>
    </footer>

    <!-- Interactive script for mobile drawer -->
    <script>
        const toggle = document.getElementById('mobileNavToggle');
        const drawer = document.getElementById('mobileNavDrawer');
        if (toggle && drawer) {
            toggle.addEventListener('click', () => {
                drawer.classList.toggle('open');
            });
            drawer.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', () => {
                    drawer.classList.remove('open');
                });
            });
        }
    </script>
</body>
</html>
